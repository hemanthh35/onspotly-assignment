   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why hybrid: CLIP alone always picks something, can't hear and\nignores blur (5/8). A vision LLM on every frame is slow and\nneeds the internet. Classic CV alone can't tell latte art from\niced coffee. Together: 8/8.",
   "originalText": "Why hybrid: CLIP alone always picks something, can't hear and\nignores blur (5/8). A vision LLM on every frame is slow and\nneeds the internet. Classic CV alone can't tell latte art from\niced coffee. Together: 8/8.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "r294",
   "lineHeight": 1.25,
   "autoResize": true
  },
