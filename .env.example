# Copy to .env and fill in. Everything is optional: without Supabase the platform
# falls back to local SQLite + ./data, and without OpenAI the planner uses rules.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Use the Session pooler URI (IPv4) from Supabase > Connect
DATABASE_URL=

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Admin dashboard ---
# Empty = admin is open (local dev only). Set a strong password before sharing the app.
ADMIN_PASSWORD=
# Random string that signs admin login tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
